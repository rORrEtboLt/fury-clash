{
  "name": "fury-clash-server",
  "version": "0.1.0",
  "description": "Fury Clash — game server (relay, matchmaker, API)",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev:api": "tsx watch src/api-server/index.ts",
    "dev:relay": "tsx watch src/relay-server/index.ts",
    "dev:matchmaker": "tsx watch src/matchmaker/index.ts",
    "start:api": "node dist/api-server/index.js",
    "start:relay": "node dist/relay-server/index.js",
    "start:matchmaker": "node dist/matchmaker/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.13.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
