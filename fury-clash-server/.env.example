# ── Server Ports ──────────────────────────────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0
RELAY_PORT=3002
RELAY_HOST=0.0.0.0
MATCHMAKER_PORT=3001
RELAY_SERVER_ID=relay-1

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://fury:fury@localhost:5432/fury_clash

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# ── Matchmaker ────────────────────────────────────────────────────────────────
MATCHMAKER_SCAN_MS=500
MATCHMAKER_ELO_RANGE_INITIAL=100
MATCHMAKER_ELO_EXPANSION_PER_SEC=20
MATCHMAKER_ELO_MAX_RANGE=500
RELAY_INTERNAL_ENDPOINT=ws://relay:3002

# ── Relay ─────────────────────────────────────────────────────────────────────
RELAY_MAX_ROOMS=500
RELAY_DISCONNECT_GRACE_SEC=10
RELAY_PING_INTERVAL_MS=5000

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development
