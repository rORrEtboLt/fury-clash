<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Bundle identity -->
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>Fury Clash</string>
    <key>CFBundleDisplayName</key>
    <string>Fury Clash</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <!-- iOS minimum version -->
    <key>MinimumOSVersion</key>
    <string>15.0</string>

    <!-- Device support: iPhone only (1), add 2 for iPad -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>

    <!-- Supported orientations (landscape for fighting game) -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Full screen, hide status bar -->
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>UIStatusBarHidden</key>
    <true/>
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleLightContent</string>

    <!-- Launch screen -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <!-- Hide home indicator for immersive game experience -->
    <key>UIHomeIndicatorAutoHidden</key>
    <true/>

    <!-- Network (no privacy description needed for client-side WebSocket) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Allow plain ws:// connections to local network servers -->
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>

    <!-- Local network usage (for LAN play) -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Fury Clash uses your local network to connect to the relay server for multiplayer matches.</string>

    <!-- Required device capabilities -->
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
        <string>metal</string>
    </array>
</dict>
</plist>
